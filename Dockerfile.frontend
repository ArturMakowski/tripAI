# Frontend image for Railway, built from the repo root. The browser calls same-origin /api; the proxy reads the
# server-only runtime vars BACKEND_INTERNAL_URL and TRIPAI_INTERNAL_KEY (never build args, never in the bundle).
FROM node:22-slim AS build
WORKDIR /app
ARG NEXT_PUBLIC_MOCK
ENV NEXT_PUBLIC_MOCK=$NEXT_PUBLIC_MOCK NEXT_TELEMETRY_DISABLED=1
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app ./
CMD ["sh", "-c", "npx next start -H 0.0.0.0 -p ${PORT:-3000}"]
