# Backend image for Railway. Built from the repo root so data/ (seed snapshot) is included.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim
WORKDIR /app/backend
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY backend/ ./
COPY data/ /app/data/
RUN uv sync --frozen --no-dev
ENV TRIPAI_DATA_DIR=/app/data PATH="/app/backend/.venv/bin:$PATH"
CMD ["sh", "-c", "uvicorn tripai.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
