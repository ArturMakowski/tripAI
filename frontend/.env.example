# Server-only (read by the /api proxy, never sent to the browser).
# Backend base URL; unset in dev -> NEXT_PUBLIC_API_URL, else http://localhost:8000. Required in production.
BACKEND_INTERNAL_URL=
# Same value as the backend's TRIPAI_INTERNAL_KEY; sent as X-TripAI-Internal-Key. Leave empty locally if the backend has none.
TRIPAI_INTERNAL_KEY=
# Force in-browser fixture mode (handy on stage with bad Wi-Fi).
NEXT_PUBLIC_MOCK=0
