OPENAI_API_KEY=
TYPESAFE_API_KEY=   # Jev (TypeSafe), via pydantic-ai TypeSafeModel; TYPESAFEAI_API_KEY also accepted
ANTHROPIC_API_KEY=
TRIPAI_MODEL=openai:gpt-6-luna  # any pydantic-ai model string
SERPAPI_API_KEY=
SERPER_API_KEY=  # serper.dev: Google search/images/places (no flights/hotels)
TRAVELPAYOUTS_TOKEN=
LITEAPI_KEY=
OPENTRIPMAP_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPABASE_URL=
SUPABASE_KEY=          # publishable (browser-safe)
SUPABASE_SECRET_KEY=   # sb_secret_..., backend only
SUPABASE_PASSWORD=
TRIPAI_USE_FIXTURES=1
TRIPAI_PROVIDER=            # live | fixture (default: fixture if TRIPAI_USE_FIXTURES=1, else live)
TRIPAI_LIVE_TOP_N=3         # cities refined with exact-date SerpApi flights + hotels
TRIPAI_LIVE_MAX_REFINE=6    # SerpApi refinement budget per request (2 calls each)
TRIPAI_LIVE_MAX_CITIES=12   # seed cities shortlisted per request
TRIPAI_FIXTURE_SOURCES=     # e.g. travelpayouts,gcal: these run on recorded fixtures, the rest live
TRIPAI_SERPAPI_DAILY_CAP=30  # hard daily SerpApi searches, shared via Supabase api_cache + disk
TRIPAI_SERPAPI_REQUEST_CAP=7 # per /recommendations call (cache hits are free)
TRIPAI_LIVE_FALLBACK=        # 1: serve labelled FixtureProvider data when live has nothing (default: 503)
TRIPAI_SESSION_SECRET=       # HMAC key for server-issued session tokens (set in prod!)
TRIPAI_STORE=               # memory forces the in-memory store even with Supabase set
DATABASE_URL=  # Supabase pooler conn string (Session mode), used by DBOS
# Web push (T5b): generate with `cd backend && uv run python -m tripai.notify.vapid`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=     # secret, backend only
VAPID_SUBJECT=mailto:armak58@gmail.com
TRIPAI_SCAN_CRON=0 0 7 * * *  # daily proactive scan (sec min hour dom mon dow, Europe/Warsaw)
# scan cost caps (defaults shown): active window, users/run, picks/user, long weekends/scan, /scan/run rate limit
TRIPAI_SCAN_ACTIVE_DAYS=14
TRIPAI_SCAN_MAX_USERS=50
TRIPAI_MAX_PICKS=5
TRIPAI_SCAN_MAX_LW=2
TRIPAI_SCAN_MIN_INTERVAL_S=60
TRIPAI_SCAN_PER_MIN=10
